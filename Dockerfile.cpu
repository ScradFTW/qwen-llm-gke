# Temporary fallback while GPU quota is pending (see bradjobe-dev-infra's
# gke.tf llm_cpu node pool) — same llama.cpp build/quantization as
# Dockerfile (the CUDA one), just without GGML_CUDA and with -ngl 0,
# exactly matching how the old VPS ran this (CPU-only, no GPU on that
# box). Swap the qwen-llm-gke trigger's _DOCKERFILE substitution back to
# `Dockerfile` and k8s/deployment.yaml back in once GPU quota lands.
FROM debian:bookworm-slim AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
      git cmake build-essential curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone --depth 1 --branch b10819 https://github.com/ggml-org/llama.cpp.git .
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --config Release -j"$(nproc)" --target llama-server

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /src/build/bin/llama-server ./llama-server
# *.so* (not *.so): llama.cpp's shared libs use SONAME versioning
# (libllama-common.so.0 etc.) — confirmed by a real crash, "error while
# loading shared libraries: libllama-common.so.0: cannot open shared
# object file", from the plain *.so glob missing every versioned one.
COPY --from=build /src/build/bin/*.so* ./

# Same model, same source, same byte size as the GPU Dockerfile — see
# that file's comment for the size-match verification against the VPS.
RUN curl -fL -o model.gguf \
      "https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct-GGUF/resolve/main/qwen2.5-0.5b-instruct-q4_k_m.gguf"

ENV LD_LIBRARY_PATH=/app
EXPOSE 8081

# Bound to loopback: only the nginx sidecar (k8s/deployment-cpu.yaml)
# talks to this directly.
ENTRYPOINT ["/app/llama-server", \
  "-m", "/app/model.gguf", \
  "--host", "127.0.0.1", \
  "--port", "8081", \
  "-c", "2048", \
  "--parallel", "2", \
  "-ngl", "0", \
  "--no-webui"]
