# Temporary fallback while GPU quota is pending (see bradjobe-dev-infra's
# gke.tf llm_cpu node pool). Built on llama.cpp's own official image
# instead of compiling from source — the from-source multi-stage build
# this replaced hit two real bugs in a row (a *.so glob that missed
# SONAME-versioned shared libs, then a missing libgomp1) that upstream's
# own image already gets right. See Dockerfile for the GPU equivalent.
#
# ENV LLAMA_ARG_HOST=0.0.0.0 is already set by this base image, and
# llama-server sends permissive CORS headers itself by default ("CORS is
# set to allow all origins", confirmed in its own startup log) — so
# there's no nginx CORS sidecar here either; an earlier version had one,
# entirely unnecessary.
FROM ghcr.io/ggml-org/llama.cpp:server

# curl is already present in this base image.
RUN curl -fL -o /model.gguf \
      "https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct-GGUF/resolve/main/qwen2.5-0.5b-instruct-q4_k_m.gguf"

# ENTRYPOINT ["/app/llama-server"] is inherited from the base image; this
# only supplies its default arguments.
CMD ["-m", "/model.gguf", "--port", "8080", "-c", "2048", "--parallel", "2", "-ngl", "0", "--no-webui"]
